# --- Конфигурация приложения ---
FLASK_SECRET_KEY=change-me-to-something-random
APP_PORT=5005
FLASK_DEBUG=1

# --- База данных (PostgreSQL) ---
# Если вы используете Docker (docker-compose up), используйте эти настройки:
DB_HOST=db
DB_PORT=5432
DB_NAME=granit_ural_ais
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/granit_ural_ais

# Если вы запускаете PostgreSQL локально (без Docker), используйте эти настройки:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=granit_ural_ais
# DB_USER=ваш_пользователь
# DB_PASSWORD=ваш_пароль
# DATABASE_URL=postgresql://ваш_пользователь:ваш_пароль@localhost:5432/granit_ural_ais

# --- Яндекс Маркет API ---
YANDEX_MARKET_API_KEY=ваш_api_ключ
YANDEX_MARKET_CAMPAIGN_ID=ваш_id_кампании
YANDEX_MARKET_BUSINESS_ID=ваш_id_бизнеса
YANDEX_MARKET_WAREHOUSE_ID=1
